{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PROJECT_DIR:-.}/scripts/cues.py\" --hook --runtime claude",
            "statusMessage": "Loading session cues",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/atelier/session-replay.toml\" ] || [ -n \"$ATELIER_SESSION_REPLAY_ENABLED\" ] && uv run \"$(git rev-parse --show-toplevel)/scripts/session_replay.py\" hook --runtime claude-code || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PROJECT_DIR:-.}/scripts/cues.py\" --touch-lock 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude/scripts/peer_review_gate.py ] && python3 ~/.claude/scripts/peer_review_gate.py 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/atelier/session-replay.toml\" ] || [ -n \"$ATELIER_SESSION_REPLAY_ENABLED\" ] && uv run \"$(git rev-parse --show-toplevel)/scripts/session_replay.py\" hook --runtime claude-code || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PROJECT_DIR:-.}/scripts/shadow.py\" gc 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${XDG_CONFIG_HOME:-$HOME/.config}/atelier/session-replay.toml\" ] || [ -n \"$ATELIER_SESSION_REPLAY_ENABLED\" ] && uv run \"$(git rev-parse --show-toplevel)/scripts/session_replay.py\" hook --runtime claude-code || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
