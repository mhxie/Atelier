# Copy to semantic.toml (gitignored). Current hardware: compact model pool.
profile = "m3-16gb"

# After moving to a 64GB machine, change the profile to "m5-64gb", then run:
#   python3 scripts/semantic.py init --download-models
#   python3 scripts/semantic.py index
# The 4B embedding model gets a separate derived index; the old one is retained.
# Presets and shared model URIs live in harness/retrieval.toml.

# Optional per-machine overrides, merged over the selected preset:
# [runtime]
# parallelism = 1
# candidate_limit = 20
# gpu = "auto"  # "metal" or "cpu" may be selected explicitly for diagnostics
# [models]
# embed = "hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf"
