{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier public harness configuration",
  "description": "Validated together before cross-file checks. Private overlays are not part of this input.",
  "type": "object",
  "required": [
    "harness/models.toml",
    "harness/agents.toml",
    "harness/skills.toml",
    "harness/capabilities.toml",
    "harness/runtimes.toml",
    "harness/intents.toml",
    "harness/paths.toml",
    "routines/registry.toml",
    ".codex/hooks.json",
    ".claude/settings.json"
  ],
  "additionalProperties": false,
  "properties": {
    "harness/models.toml": {
      "type": "object",
      "required": ["models"],
      "propertyNames": {"not": {"enum": ["profiles", "agents"]}},
      "properties": {
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["reasoning_tier"],
            "propertyNames": {
              "not": {
                "enum": [
                  "agy", "claude_code", "codex", "codex_reasoning_effort", "direct_api",
                  "direct_api_base", "direct_api_extras", "direct_api_timeout", "api_env"
                ]
              }
            },
            "properties": {
              "reasoning_tier": {"$ref": "#/$defs/text"},
              "binding_optional": {"type": "boolean"}
            }
          }
        }
      }
    },
    "harness/agents.toml": {
      "type": "object",
      "required": ["agents"],
      "properties": {
        "agents": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["source", "voices", "status", "description"],
            "properties": {
              "source": {"$ref": "#/$defs/text"},
              "status": {"$ref": "#/$defs/text"},
              "description": {"$ref": "#/$defs/text"},
              "voices": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"enum": ["native", "direct", "codex", "agy"]},
                "additionalProperties": {"$ref": "#/$defs/text"}
              }
            },
            "if": {"properties": {"status": {"const": "script-driven"}}},
            "then": {"properties": {"source": {"not": {"pattern": "^agents/"}}}},
            "else": {"properties": {"source": {"pattern": "^agents/[a-z][a-z0-9-]*\\.md$"}}}
          }
        }
      }
    },
    "harness/skills.toml": {
      "type": "object",
      "required": ["skills"],
      "properties": {
        "skills": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["source", "category", "status", "description"],
            "properties": {
              "source": {"type": "string", "pattern": "^skills/[a-z][a-z0-9-]*/SKILL\\.md$"},
              "category": {"$ref": "#/$defs/text"},
              "status": {"$ref": "#/$defs/text"},
              "description": {"$ref": "#/$defs/text"},
              "direct_only": {"type": "boolean"},
              "alias_of": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "harness/capabilities.toml": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "codex"],
            "properties": {
              "description": {"$ref": "#/$defs/text"},
              "codex": {"$ref": "#/$defs/strings", "minItems": 1}
            }
          }
        }
      }
    },
    "harness/runtimes.toml": {
      "type": "object",
      "required": ["runtime", "runtimes"],
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["default", "local_override", "environment_override"],
          "properties": {
            "default": {"const": "codex"},
            "local_override": {"const": "harness/runtime.local.toml"},
            "environment_override": {"const": "ATELIER_RUNTIME"},
            "observability_reference": {"const": "sources/runtimes/observability.md"}
          }
        },
        "runtimes": {
          "type": "object",
          "required": ["codex", "claude"],
          "properties": {
            "codex": {"properties": {"command_prefix": {"const": "$"}}},
            "claude": {"properties": {"command_prefix": {"const": "/"}}}
          },
          "patternProperties": {".*": {"$ref": "#/$defs/runtime"}}
        }
      }
    },
    "harness/intents.toml": {
      "type": "object",
      "required": ["intents"],
      "properties": {
        "intents": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["description", "mode", "procedure", "context_budget_tokens"],
            "propertyNames": {"not": {"enum": ["patterns", "priority", "context_budget_bytes"]}},
            "properties": {
              "description": {"$ref": "#/$defs/text"},
              "mode": {"$ref": "#/$defs/text"},
              "procedure": {"$ref": "#/$defs/text"},
              "context_budget_tokens": {"type": "integer", "minimum": 1, "maximum": 16384},
              "agents": {"$ref": "#/$defs/strings"},
              "profile_reads": {"$ref": "#/$defs/strings"},
              "examples": {"$ref": "#/$defs/strings"}
            }
          }
        }
      }
    },
    "harness/paths.toml": {
      "type": "object",
      "required": ["paths", "knowledge_levels"],
      "properties": {
        "knowledge_levels": {
          "type": "object",
          "required": ["1", "2", "3", "4"],
          "additionalProperties": false,
          "patternProperties": {
            "^[1-4]$": {
              "type": "object",
              "required": ["label", "paths"],
              "additionalProperties": false,
              "properties": {
                "label": {"$ref": "#/$defs/text"},
                "paths": {"$ref": "#/$defs/strings"},
                "segments": {"$ref": "#/$defs/strings"}
              }
            }
          }
        },
        "paths": {
          "type": "object",
          "properties": {
            "wiki_localized": {"type": "object", "additionalProperties": {"type": "string"}}
          },
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "routines/registry.toml": {
      "type": "object",
      "required": ["version", "adapters", "routine"],
      "properties": {
        "version": {"const": 1},
        "adapters": {
          "type": "object",
          "required": ["archived-prompt", "autoevo"],
          "additionalProperties": {
            "type": "object",
            "required": ["procedure"],
            "properties": {"procedure": {"type": "string", "pattern": "^routines/_adapters/[a-z][a-z0-9-]*/PROCEDURE\\.md$"}}
          }
        },
        "routine": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "runner", "cron", "timezone", "argv", "timeout_seconds", "retry_safe"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "runner": {"const": "process"},
              "cron": {"oneOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/strings"}]},
              "timezone": {"$ref": "#/$defs/text"},
              "argv": {"$ref": "#/$defs/strings", "minItems": 1},
              "timeout_seconds": {"type": "integer", "minimum": 1},
              "retry_safe": {"type": "boolean"},
              "retries": {"type": "integer", "minimum": 0},
              "retry_delay_seconds": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    ".codex/hooks.json": {"$ref": "#/$defs/hooks"},
    ".claude/settings.json": {"$ref": "#/$defs/hooks"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "runtime": {
      "type": "object",
      "required": ["label", "executable", "command_prefix", "shell_args", "interactive_args", "non_interactive_args"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "executable": {"$ref": "#/$defs/text"},
        "command_prefix": {"$ref": "#/$defs/text"},
        "capability_reference": {"type": "string", "pattern": "^sources/runtimes/[a-z][a-z0-9-]*\\.md$"}
      },
      "patternProperties": {"_args$": {"$ref": "#/$defs/strings"}}
    },
    "hooks": {
      "type": "object",
      "required": ["hooks"],
      "properties": {
        "hooks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["hooks"],
              "properties": {
                "hooks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {"command": {"type": "string"}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
