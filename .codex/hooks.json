{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$(git rev-parse --show-toplevel)/scripts/cues.py\" --hook --runtime codex",
            "statusMessage": "Loading Atelier session cues",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$(git rev-parse --show-toplevel)/scripts/cues.py\" --touch-lock",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$(git rev-parse --show-toplevel)/scripts/invocation_log_gc.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
