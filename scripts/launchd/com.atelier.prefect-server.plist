<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atelier.prefect-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ATELIER_ROOT__/scripts/routine_prefect_service.sh</string>
        <string>server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.atelier.prefect-server.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.atelier.prefect-server.err</string>
</dict>
</plist>
